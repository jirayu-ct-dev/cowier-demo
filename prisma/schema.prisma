// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum UserRole {
  ADMIN
  LECTURER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CoopTermStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum Region {
  NORTH
  CENTRAL
  SOUTH
  NORTHEAST
  EAST
  WEST
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum SupervisionType {
  ONSITE
  ONLINE
}

enum SupervisionStatus {
  SCHEDULED
  COMPLETED
  POSTPONED
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REIMBURSED
  REJECTED
}

// ------------------------------------------------------
// USER & PROFILES
// ------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studentProfile  StudentProfile?
  lecturerProfile LecturerProfile?
  staffProfile    StaffProfile?

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String   @unique
  title       String?
  firstName   String
  lastName    String
  phone       String?
  faculty     String?
  department  String?
  major       String?
  gpa         Decimal? @db.Decimal(3, 2)

  coopTermId String?
  coopTerm   CoopTerm? @relation(fields: [coopTermId], references: [id], onDelete: SetNull)

  confirmedCompanyId String?
  confirmedCompany   Company? @relation(fields: [confirmedCompanyId], references: [id], onDelete: SetNull)

  applications         StudentApplication[]
  supervisionSchedules SupervisionSchedule[]
  evaluations          StudentEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentCode])
  @@index([coopTermId])
  @@index([confirmedCompanyId])
}

model LecturerProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecturerCode  String  @unique
  academicTitle String?
  firstName     String
  lastName      String
  phone         String?
  faculty       String?
  department    String?

  assignments          LecturerAssignment[]
  supervisionSchedules SupervisionSchedule[]
  studentEvaluations   StudentEvaluation[]
  companyEvaluations   CompanyEvaluation[]
  supervisionExpenses  SupervisionExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lecturerCode])
}

model StaffProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffCode  String  @unique
  title      String?
  firstName  String
  lastName   String
  department String?
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffCode])
}

// ------------------------------------------------------
// COOPERATIVE EDUCATION TERMS & MASTER DATA
// ------------------------------------------------------

model CoopTerm {
  id           String         @id @default(cuid())
  academicYear Int // e.g. 2569
  semester     Int // e.g. 1, 2, 3
  title        String // e.g. "ภาคเรียนที่ 1/2569"
  startDate    DateTime
  endDate      DateTime
  status       CoopTermStatus @default(UPCOMING)
  isCurrent    Boolean        @default(false)

  students             StudentProfile[]
  applications         StudentApplication[]
  assignments          LecturerAssignment[]
  supervisionSchedules SupervisionSchedule[]
  supervisionExpenses  SupervisionExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYear, semester])
  @@index([isCurrent])
  @@index([status])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  businessType    String?
  address         String?
  subdistrict     String?
  district        String?
  province        String // e.g. "กรุงเทพมหานคร", "เชียงใหม่"
  postalCode      String?
  region          Region   @default(CENTRAL)
  contactName     String?
  contactPosition String?
  contactPhone    String?
  contactEmail    String?
  website         String?
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  isActive        Boolean  @default(true)

  confirmedStudents    StudentProfile[]
  applications         StudentApplication[]
  assignments          LecturerAssignment[]
  supervisionSchedules SupervisionSchedule[]
  evaluations          CompanyEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
  @@index([region])
  @@index([name])
}

model StudentApplication {
  id           String            @id @default(cuid())
  studentId    String
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coopTermId   String
  coopTerm     CoopTerm          @relation(fields: [coopTermId], references: [id], onDelete: Cascade)
  priority     Int               @default(1)
  status       ApplicationStatus @default(PENDING)
  appliedAt    DateTime          @default(now())
  responseNote String?
  confirmedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, companyId, coopTermId])
  @@index([status])
  @@index([coopTermId])
}

model LecturerAssignment {
  id         String          @id @default(cuid())
  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  coopTermId String
  coopTerm   CoopTerm        @relation(fields: [coopTermId], references: [id], onDelete: Cascade)

  // Assigned Area Scope (Optional narrowing)
  region    Region?
  province  String?
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lecturerId, coopTermId])
  @@index([province])
  @@index([region])
}

// ------------------------------------------------------
// SUPERVISION SCHEDULING, EVALUATION & EXPENSES
// ------------------------------------------------------

model SupervisionSchedule {
  id              String            @id @default(cuid())
  coopTermId      String
  coopTerm        CoopTerm          @relation(fields: [coopTermId], references: [id], onDelete: Cascade)
  round           Int               @default(1) // Visit 1 or Visit 2
  scheduledDate   DateTime
  startTime       String? // e.g. "09:30"
  endTime         String? // e.g. "12:00"
  supervisionType SupervisionType   @default(ONSITE)
  status          SupervisionStatus @default(SCHEDULED)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  notes String?

  record              SupervisionRecord?
  studentEvaluations  StudentEvaluation[]
  companyEvaluations  CompanyEvaluation[]
  supervisionExpenses SupervisionExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledDate])
  @@index([lecturerId, scheduledDate])
  @@index([studentId, round])
  @@index([companyId])
  @@index([status])
}

model SupervisionRecord {
  id                    String              @id @default(cuid())
  supervisionScheduleId String              @unique
  supervisionSchedule   SupervisionSchedule @relation(fields: [supervisionScheduleId], references: [id], onDelete: Cascade)

  visitDate              DateTime
  actualSupervisionType  SupervisionType @default(ONSITE)
  studentProgressNotes   String?         @db.Text
  problemsFound          String?         @db.Text
  suggestionsForStudent  String?         @db.Text
  suggestionsForCompany  String?         @db.Text
  companyFeedback        String?         @db.Text
  completedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentEvaluation {
  id                    String               @id @default(cuid())
  supervisionScheduleId String?
  supervisionSchedule   SupervisionSchedule? @relation(fields: [supervisionScheduleId], references: [id], onDelete: SetNull)

  studentId  String
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  round               Int      @default(1)
  scoreKnowledge      Decimal? @db.Decimal(5, 2)
  scoreSkill          Decimal? @db.Decimal(5, 2)
  scoreResponsibility Decimal? @db.Decimal(5, 2)
  scoreAdaptability   Decimal? @db.Decimal(5, 2)
  totalScore          Decimal  @db.Decimal(5, 2)
  maxScore            Decimal  @default(100) @db.Decimal(5, 2)
  remarks             String?  @db.Text
  evaluatedAt         DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, round])
  @@index([lecturerId])
}

model CompanyEvaluation {
  id                    String               @id @default(cuid())
  supervisionScheduleId String?
  supervisionSchedule   SupervisionSchedule? @relation(fields: [supervisionScheduleId], references: [id], onDelete: SetNull)

  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  round                 Int      @default(1)
  scoreEnvironment      Decimal? @db.Decimal(5, 2)
  scoreSafety           Decimal? @db.Decimal(5, 2)
  scoreMentorship       Decimal? @db.Decimal(5, 2)
  scoreBenefit          Decimal? @db.Decimal(5, 2)
  totalScore            Decimal  @db.Decimal(5, 2)
  maxScore              Decimal  @default(100) @db.Decimal(5, 2)
  isSuitableForFuture   Boolean  @default(true)
  suggestions           String?  @db.Text
  evaluatedAt           DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, lecturerId, round])
  @@index([companyId])
}

model SupervisionExpense {
  id                    String               @id @default(cuid())
  supervisionScheduleId String?
  supervisionSchedule   SupervisionSchedule? @relation(fields: [supervisionScheduleId], references: [id], onDelete: SetNull)

  lecturerId String
  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  coopTermId String
  coopTerm   CoopTerm @relation(fields: [coopTermId], references: [id], onDelete: Cascade)

  travelCost        Decimal       @default(0) @db.Decimal(10, 2)
  accommodationCost Decimal       @default(0) @db.Decimal(10, 2)
  allowanceCost     Decimal       @default(0) @db.Decimal(10, 2)
  otherCost         Decimal       @default(0) @db.Decimal(10, 2)
  totalCost         Decimal       @default(0) @db.Decimal(10, 2)
  remarks           String?
  receiptUrls       String[]      @default([])
  status            ExpenseStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lecturerId, coopTermId])
  @@index([status])
}
