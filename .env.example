# Environment variables declared in this file are automatically made available to Prisma and Nuxt.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# MySQL 8.4 LTS connection string
DATABASE_URL="mysql://ciwie:change_this_mysql_password@localhost:3306/ciwie_db"
TEST_DATABASE_URL="mysql://ciwie:change_this_mysql_password@localhost:3306/ciwie_test"
SEED_STAFF_PASSWORD="change_this_initial_staff_password"
MYSQL_DATABASE="ciwie_db"
MYSQL_TEST_DATABASE="ciwie_test"
MYSQL_USER="ciwie"
MYSQL_PASSWORD="change_this_mysql_password"
MYSQL_ROOT_PASSWORD="change_this_mysql_root_password"
MYSQL_PORT="3306"

# Nuxt Auth secret (session encryption)
NUXT_SESSION_PASSWORD="change_this_to_at_least_32_characters_long_secret_key"
NUXT_SESSION_COOKIE_SECURE="false"

# Optional development seed account. Seed will skip Staff creation when omitted.
SEED_STAFF_USERNAME="staff001"
SEED_STAFF_PASSWORD="change_this_temporary_password"
SEED_STAFF_NAME_PREFIX="เจ้าหน้าที่"
SEED_STAFF_FIRST_NAME="ระบบ"
SEED_STAFF_LAST_NAME="สหกิจศึกษา"
